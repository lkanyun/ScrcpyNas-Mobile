.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pfx
id_rsa*
id_ed25519*
known_hosts*
session-config.json
turn.json
devices.json
shares.json
sessions/
*.bundle
*.har
*.pcap
*.pcapng
._*

